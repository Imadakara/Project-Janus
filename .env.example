# PostgreSQL connection string. Must stay in sync with POSTGRES_USER / POSTGRES_PASSWORD /
# POSTGRES_DB / POSTGRES_PORT below if you're using the bundled docker-compose Postgres
# (this project has no SQLite fallback — Prisma's datasource provider is hardcoded "postgresql").
DATABASE_URL="postgresql://janus:janus_dev_password@localhost:5432/project_janus?schema=public"

# Local/dev Postgres, provisioned via docker-compose.yml (see scripts/start.sh|.bat)
POSTGRES_USER=janus
POSTGRES_PASSWORD=janus_dev_password
POSTGRES_DB=project_janus
POSTGRES_PORT=5432

# Anthropic API key used by /lib/ai to talk to Claude
ANTHROPIC_API_KEY=""

# Активный провайдер Слоя 3 (гибридный диалоговый движок) — claude | local. По умолчанию
# claude; в дебаг-режиме тумблер «Локальная LLM» панели отладки переключает источник на лету
# для отдельного запроса, независимо от этой переменной (см. lib/ai/providers/index.ts).
# local — self-hosted OpenAI-совместимый эндпоинт (/v1/chat/completions), см.
# lib/ai/providers/local.ts. Значения ниже — под локальную Ollama с qwen2.5:3b, выбранной по
# результатам ручного сравнения в experiments/llm-bench/ (см. README.md стенда, «Известные
# грабли» — thinking-модели вроде qwen3 без правок туда НЕ годятся).
LLM_PROVIDER=claude
LOCAL_LLM_BASE_URL="http://localhost:11434"
LOCAL_LLM_MODEL="qwen2.5:3b"

# Secret used to sign auth session tokens (generate with `openssl rand -base64 32`)
AUTH_SECRET=""
