// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output          = "../app/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Player {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(UNASSIGNED)
  createdAt    DateTime @default(now())
  trustLevel   Int      @default(0) // уровень доверия ИИ к игроку, задел на будущее

  chatSessions  ChatSession[]
  moduleUnlocks PlayerModuleUnlock[]
  fileAnalyses  PlayerFileAnalysis[]
  events        Event[]
}

enum Role {
  UNASSIGNED
  ARCHIVIST // Архивист
  TECHNICIAN // Техник
  SECURITY_OFFICER // Офицер безопасности
}

// --- Диалог с ИИ ---

model ChatSession {
  id        String        @id @default(cuid())
  playerId  String
  player    Player        @relation(fields: [playerId], references: [id])
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // --- Гибридный диалоговый движок (Слои 1-3), состояние сессии ---
  disposition        Json    @default("{\"trust\":0,\"tension\":0}") // оси состояния ИИ
  activeContext      String? // текущий модуль/тема
  shortTermMemory    Json    @default("[]") // последние упомянутые сущности
  intentRepeatCount  Json    @default("{}") // { "ASK_IDENTITY": 2, ... }
  desyncScore        Int     @default(0) // счётчик рассинхронизации, см. lib/scenario
  lastConfidenceTier String? // "high" | "medium" | "low", нужно для стрик-правила desyncScore

  @@index([playerId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id])
  role      MessageRole // PLAYER | AI
  content   String
  createdAt DateTime    @default(now())

  // --- Телеметрия гибридного диалогового движка (заполняется только для role=AI) ---
  handledByLayer   MessageLayer?
  matchedIntent    String?
  intentConfidence Float?
  escalationReason String?

  @@index([sessionId])
}

enum MessageRole {
  PLAYER
  AI
}

enum MessageLayer {
  DETERMINISTIC
  LIGHT_LLM
  FULL_LLM
}

// --- Командные модули (подпрограммы терминала) ---

model CommandModule {
  key          String  @id // FILE_MANAGER, FILE_ANALYZER, TEXT_VIEWER, SEARCH, MEMORY_MANAGER, MAP_VIEWER, ...
  name         String // отображаемое имя, например "АНАЛИЗАТОР ФАЙЛОВ"
  description  String
  isDefault    Boolean @default(false) // true = доступен всем ролям сразу после регистрации
  requiredRole Role? // если задано — доступен только этой роли (сверх изначальной разблокировки)

  unlocks PlayerModuleUnlock[]
  files   TerminalFile[]
}

model PlayerModuleUnlock {
  id         String        @id @default(cuid())
  playerId   String
  player     Player        @relation(fields: [playerId], references: [id])
  moduleKey  String
  module     CommandModule @relation(fields: [moduleKey], references: [key])
  unlockedAt DateTime      @default(now())

  @@unique([playerId, moduleKey])
}

// --- Файловая система терминала ---

model TerminalFolder {
  id            String  @id @default(cuid())
  path          String  @unique // например "/ARCHIVE/TACTICAL"
  name          String // отображаемое имя папки
  parentPath    String?
  visibleToRole Role? // null = видна всем ролям
}

model TerminalFile {
  id                String        @id @default(cuid())
  folderPath        String
  filename          String // например "SITREP-004"
  extension         String // например ".TAC", ".LOG", ".DAT", ".TXT"
  requiredModuleKey String // модуль, необходимый для ПОЛНОГО открытия файла (например MAP_VIEWER)
  requiredModule    CommandModule @relation(fields: [requiredModuleKey], references: [key])
  fullContent       String // полный текст/контент, отдаётся только при открытии нужным модулем
  analysisSummary   String // укороченный/искажённый вывод, который даёт FILE_ANALYZER независимо от наличия нужного модуля
  visibleToRole     Role? // null = видим всем ролям

  // RAG-фоллбэк для Слоя 3 (полный режим), см. lib/ai/rag.ts. Заполняется в prisma/seed.ts
  // эмбеддингом fullContent, не в рантайме.
  embedding Unsupported("vector(384)")?

  analyses PlayerFileAnalysis[]

  @@index([folderPath])
}

// --- Логирование вызовов LLM (для анализа стоимости/латентности) ---

model LlmCallLog {
  id           String   @id @default(cuid())
  playerId     String
  sessionId    String
  model        String
  inputTokens  Int
  outputTokens Int
  latencyMs    Int
  createdAt    DateTime @default(now())

  @@index([playerId])
}

model PlayerFileAnalysis {
  id         String       @id @default(cuid())
  playerId   String
  player     Player       @relation(fields: [playerId], references: [id])
  fileId     String
  file       TerminalFile @relation(fields: [fileId], references: [id])
  analyzedAt DateTime     @default(now())

  @@unique([playerId, fileId])
}

// --- Аналитика MVP ---

model Event {
  id        String   @id @default(cuid())
  playerId  String?
  player    Player?  @relation(fields: [playerId], references: [id])
  type      String // REGISTER, LOGIN, CHAT_MESSAGE, FILE_MANAGER_OPENED, FILE_ANALYZED, FILE_OPEN_DENIED
  payload   Json?
  createdAt DateTime @default(now())

  @@index([playerId])
  @@index([type])
}

// --- Гибридный диалоговый движок: интерпретатор intent'ов (Слой 2) и пулы ответов (Слой 1) ---

model Intent {
  id            String          @id @default(cuid())
  code          String          @unique // ASK_IDENTITY, ASK_HISTORY, REPORT_ARCHIVE_FOUND...
  description   String?
  examples      IntentExample[]
  responsePools ResponsePool[]
}

model IntentExample {
  id       String @id @default(cuid())
  intentId String
  intent   Intent @relation(fields: [intentId], references: [id])
  phrase   String // эталонная формулировка для эмбеддинг-мэтчинга

  // pgvector, размерность под lib/embeddings/client.ts (paraphrase-multilingual-MiniLM-L12-v2 = 384)
  embedding Unsupported("vector(384)")?

  @@unique([intentId, phrase])
  @@index([intentId])
}

enum ResponsePoolType {
  NORMAL
  REPEATED // 3+ повтор того же intent за сессию
  ANNOYED // высокое напряжение в disposition
}

model ResponsePool {
  id           String             @id @default(cuid())
  intentId     String
  intent       Intent             @relation(fields: [intentId], references: [id])
  type         ResponsePoolType   @default(NORMAL)
  requiredRole Role? // null = для всех ролей
  fragments    ResponseFragment[]

  @@unique([intentId, type, requiredRole])
}

model ResponseFragment {
  id       String       @id @default(cuid())
  poolId   String
  pool     ResponsePool @relation(fields: [poolId], references: [id])
  template String // текст с плейсхолдерами вида {{slotName}} под синонимы/слоты

  @@index([poolId])
}
