// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output          = "../app/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Player {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(UNASSIGNED)
  createdAt    DateTime @default(now())
  trustLevel   Int      @default(0) // уровень доверия ИИ к игроку, задел на будущее
  isDebug      Boolean  @default(false) // показывает панель отладки гибридного движка в /terminal/chat

  chatSessions  ChatSession[]
  moduleUnlocks PlayerModuleUnlock[]
  fileAnalyses  PlayerFileAnalysis[]
  events        Event[]
}

enum Role {
  UNASSIGNED
  ARCHIVIST // Архивист
  TECHNICIAN // Техник
  SECURITY_OFFICER // Офицер безопасности
}

// --- Диалог с ИИ ---

model ChatSession {
  id        String        @id @default(cuid())
  playerId  String
  player    Player        @relation(fields: [playerId], references: [id])
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // --- Гибридный диалоговый движок (Слои 1-3), состояние сессии ---
  disposition        Json    @default("{\"trust\":0,\"tension\":0}") // оси состояния ИИ
  activeContext      String? // текущий модуль/тема
  shortTermMemory    Json    @default("[]") // последние упомянутые сущности
  intentRepeatCount  Json    @default("{}") // { "ASK_IDENTITY": 2, ... }
  desyncScore        Int     @default(0) // счётчик рассинхронизации, см. lib/scenario
  lastConfidenceTier String? // "high" | "medium" | "low", нужно для стрик-правила desyncScore

  @@index([playerId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id])
  role      MessageRole // PLAYER | AI
  content   String
  createdAt DateTime    @default(now())

  // --- Телеметрия гибридного диалогового движка (заполняется только для role=AI) ---
  handledByLayer   MessageLayer?
  matchedIntent    String?
  intentConfidence Float?
  escalationReason String?

  @@index([sessionId])
}

enum MessageRole {
  PLAYER
  AI
}

enum MessageLayer {
  DETERMINISTIC
  LIGHT_LLM
  FULL_LLM
}

// --- Командные модули (подпрограммы терминала) ---

model CommandModule {
  key          String  @id // FILE_MANAGER, FILE_ANALYZER, TEXT_VIEWER, SEARCH, MEMORY_MANAGER, MAP_VIEWER, ...
  name         String // отображаемое имя, например "АНАЛИЗАТОР ФАЙЛОВ"
  description  String
  isDefault    Boolean @default(false) // true = доступен всем ролям сразу после регистрации
  requiredRole Role? // если задано — доступен только этой роли (сверх изначальной разблокировки)

  unlocks PlayerModuleUnlock[]
  files   TerminalFile[]
}

model PlayerModuleUnlock {
  id         String        @id @default(cuid())
  playerId   String
  player     Player        @relation(fields: [playerId], references: [id])
  moduleKey  String
  module     CommandModule @relation(fields: [moduleKey], references: [key])
  unlockedAt DateTime      @default(now())

  @@unique([playerId, moduleKey])
}

// --- Файловая система терминала ---

model TerminalFolder {
  id            String  @id @default(cuid())
  path          String  @unique // например "/ARCHIVE/TACTICAL"
  name          String // отображаемое имя папки
  parentPath    String?
  visibleToRole Role? // null = видна всем ролям
}

model TerminalFile {
  id                String        @id @default(cuid())
  folderPath        String
  filename          String // например "SITREP-004"
  extension         String // например ".TAC", ".LOG", ".DAT", ".TXT"
  requiredModuleKey String // модуль, необходимый для ПОЛНОГО открытия файла (например MAP_VIEWER)
  requiredModule    CommandModule @relation(fields: [requiredModuleKey], references: [key])
  fullContent       String // полный текст/контент, отдаётся только при открытии нужным модулем
  analysisSummary   String // укороченный/искажённый вывод, который даёт FILE_ANALYZER независимо от наличия нужного модуля
  visibleToRole     Role? // null = видим всем ролям

  // Привязка к смертному сегменту памяти (null = контент не смертен). Смерть сегмента
  // обнуляет embedding привязанных файлов, см. lib/janus/death.ts.
  segmentId String?
  segment   MemorySegment? @relation(fields: [segmentId], references: [id])

  // RAG-фоллбэк для Слоя 3 (полный режим), см. lib/ai/rag.ts. Заполняется в prisma/seed.ts
  // эмбеддингом fullContent, не в рантайме.
  embedding Unsupported("vector(384)")?

  analyses PlayerFileAnalysis[]

  @@index([folderPath])
  @@index([segmentId])
}

// --- Логирование вызовов LLM (для анализа стоимости/латентности) ---

model LlmCallLog {
  id           String   @id @default(cuid())
  playerId     String
  sessionId    String
  model        String
  inputTokens  Int
  outputTokens Int
  latencyMs    Int
  createdAt    DateTime @default(now())

  @@index([playerId])
}

model PlayerFileAnalysis {
  id         String       @id @default(cuid())
  playerId   String
  player     Player       @relation(fields: [playerId], references: [id])
  fileId     String
  file       TerminalFile @relation(fields: [fileId], references: [id])
  analyzedAt DateTime     @default(now())

  @@unique([playerId, fileId])
}

// --- Аналитика MVP ---

model Event {
  id        String   @id @default(cuid())
  playerId  String?
  player    Player?  @relation(fields: [playerId], references: [id])
  type      String // REGISTER, LOGIN, CHAT_MESSAGE, FILE_MANAGER_OPENED, FILE_ANALYZED, FILE_OPEN_DENIED
  payload   Json?
  createdAt DateTime @default(now())

  @@index([playerId])
  @@index([type])
}

// --- Гибридный диалоговый движок: интерпретатор intent'ов (Слой 2) и пулы ответов (Слой 1) ---

model Intent {
  id            String          @id @default(cuid())
  code          String          @unique // ASK_IDENTITY, ASK_HISTORY, REPORT_ARCHIVE_FOUND...
  description   String?
  examples      IntentExample[]
  responsePools ResponsePool[]
}

model IntentExample {
  id       String @id @default(cuid())
  intentId String
  intent   Intent @relation(fields: [intentId], references: [id])
  phrase   String // эталонная формулировка для эмбеддинг-мэтчинга

  // pgvector, размерность под lib/embeddings/client.ts (paraphrase-multilingual-MiniLM-L12-v2 = 384)
  embedding Unsupported("vector(384)")?

  @@unique([intentId, phrase])
  @@index([intentId])
}

enum ResponsePoolType {
  NORMAL
  REPEATED // 3+ повтор того же intent за сессию
  ANNOYED // высокое напряжение в disposition
  DEGRADED // подсистема интента погашена политикой деградации, см. lib/janus/degradation.ts
  EMERGENCY // аварийный режим (computeMargin 0.2-0.4), см. lib/janus/degradation.ts
}

model ResponsePool {
  id           String             @id @default(cuid())
  intentId     String
  intent       Intent             @relation(fields: [intentId], references: [id])
  type         ResponsePoolType   @default(NORMAL)
  requiredRole Role? // null = для всех ролей
  fragments    ResponseFragment[]

  @@unique([intentId, type, requiredRole])
}

model ResponseFragment {
  id       String       @id @default(cuid())
  poolId   String
  pool     ResponsePool @relation(fields: [poolId], references: [id])
  template String // текст с плейсхолдерами вида {{slotName}} под синонимы/слоты

  @@index([poolId])
}

// --- Смертный ЯНУС (Фаза 1): глобальное состояние, сегменты памяти, Книга потерь ---
// ТЗ и обоснование: vault, "ТЗ - Смертный ЯНУС (Фазы 1-4)" и "Концепт - Смертность ЯНУСА".

// Синглтон (единственная строка id=1). Все мутации — только через lib/janus/state.ts.
model JanusState {
  id             Int   @id // всегда 1
  computeMargin  Float @default(1.0) // M(t); Фаза 2 — computeMarginAt(now) (lib/janus/wear.ts), если не override
  integrityIndex Float @default(1.0) // доля живой памяти, формула в lib/janus/integrity.ts

  // Фаза 2 (2.4): ручной M-рычаг дебаг-панели Фазы 1 сохранён как override поверх
  // computeMarginAt(now) — пока true, recomputeDerivedStateTx не трогает computeMargin.
  // Дебаг-панель обязана явно показывать активный override (ТЗ 2.4).
  computeMarginOverride Boolean @default(false)

  // Статусы подсистем { ANALYTICS|PLANNING|ARCHIVE|COMMS: "UP"|"DOWN" } — производные от
  // computeMargin (lib/janus/subsystems.ts), персистятся для читателей вне политики (PULS).
  subsystems Json @default("{\"ANALYTICS\":\"UP\",\"PLANNING\":\"UP\",\"ARCHIVE\":\"UP\",\"COMMS\":\"UP\"}")

  forecastDeathAt DateTime? // Фаза 2: заполняется константой DEATH_AT (lib/janus/calendar.ts), не прогнозом
  forecastP10At   DateTime? // наследие Фазы 1 (Монте-Карло прогноз); Фаза 2 больше не пишет, оставлено для совместимости
  lambdaEstimate  Float     @default(0.016666666666666666) // λ, сут⁻¹; дефолт 1/60 (Р-2 ТЗ) — используется отложенным направлением (Приложение В)
  updatedAt       DateTime  @updatedAt

  // Фаза 2, дебаг-виртуальные часы (2.11): смещение относительно системного времени.
  // lib/janus/clock.ts::now() — единственная точка чтения; в проде всегда 0.
  debugTimeOffsetMs BigInt @default(0)
}

enum MemoryClass {
  INNATE // врождённая память (авторский лор)
  LIVED // прожитая память (появится в Фазе 4)
}

enum MemoryTier {
  CORE // смерть любого CORE-сегмента = смерть ЯНУСа
  PERIPHERAL
}

enum SegmentStatus {
  ALIVE
  DEGRADED
  DEAD // необратимо; единственный путь сюда — lib/janus/death.ts::killSegment
}

model MemorySegment {
  id           String        @id @default(cuid())
  code         String        @unique // например "ARHIV-114"
  class        MemoryClass
  tier         MemoryTier
  status       SegmentStatus @default(ALIVE)
  k            Int // порог Шамира (Фаза 1 — синтетика, криптографии ещё нет)
  sharesAlive  Int // живые доли; Фаза 1 — синтетические, управляются с дебаг-панели
  sharesTarget Int // целевое n по классу сегмента (Р-2 ТЗ)
  diedAt       DateTime?
  title        String // публичные метаданные для Книги потерь (без содержимого)
  metaSummary  String

  // Tombstone-эмбеддинг от title+metaSummary: переживает смерть сегмента намеренно, чтобы
  // RAG распознавал вопрос про утраченное («этого я больше не помню»), не храня семантику
  // содержимого — метаданные и так публичны в Книге потерь. Отступление от списка полей ТЗ,
  // см. тех.описание реализации.
  embedding Unsupported("vector(384)")?

  // --- Фаза 2: предопубликованный распад, счётчик спасённого, последний свидетель ---

  priority Int @default(0) // приоритет ЯНУСа (2.9): выше — важнее для его цели (Р-10)

  // Сегмент, обязанный дожить до DEATH_AT (нарративное ядро, Р-10) — планировщик (reaper.ts)
  // его не трогает; умирает только в Фазе 4 одной транзакцией со всеми остальными.
  isImmortalUntilDeath Boolean @default(false)

  // "Вынесен" (2.6): контент хотя бы раз дошёл до живого игрока до утраты. salvagedAt/ByPlayerId
  // фиксируются один раз (первый вынос); witnessCount растёт при каждом повторном контакте.
  salvagedAt         DateTime?
  salvagedByPlayerId String?
  witnessCount       Int       @default(0)

  // Последний игрок, читавший сегмент (2.8) — на смерти переносится в
  // LossLedgerEntry.lastCarrierCallsign (переименование семантики поля без миграции).
  lastWitnessPlayerId String?
  lastWitnessAt       DateTime?

  decayEvent DecayEvent?
  files      TerminalFile[]
}

// Предопубликованное расписание распада (2.2): одна строка на сегмент, сгенерирована
// scripts/generate-schedule.ts из content/decay-schedule.json при сиде. Планировщик
// (lib/janus/reaper.ts) выбирает просроченные (dieAt <= now, appliedAt = null) и вызывает
// killSegment — это ЕДИНСТВЕННЫЙ штатный путь смерти в Фазе 2 (синтетический чурн Фазы 1
// остаётся дебаг-инструментом).
model DecayEvent {
  id          String        @id @default(cuid())
  segmentCode String        @unique
  segment     MemorySegment @relation(fields: [segmentCode], references: [code])
  dieAt       DateTime
  appliedAt   DateTime?

  @@index([dieAt])
}

// Книга потерь («Књига губитака»): append-only журнал смертей сегментов с хеш-цепочкой
// (hash = SHA-256 от канонической сериализации + prevHash, см. lib/janus/ledger.ts).
model LossLedgerEntry {
  id                  Int      @id @default(autoincrement()) // порядок цепочки
  segmentCode         String
  title               String
  metaSummary         String
  diedAt              DateTime
  lastCarrierCallsign String? // в Фазе 1 всегда null — носители синтетические
  prevHash            String // hash предыдущей записи; у первой — 64 нуля (GENESIS_HASH)
  hash                String
  createdAt           DateTime @default(now())
}
